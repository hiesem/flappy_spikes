rules_version = '2';

// Flappy Spikes Storage: closed (WP-AV, 2.4).
// The versus pictures (avatars/{uid}.jpg, PRD-2.3 §21.3) are gone: the versus avatar is
// drawn on each phone from the player's bird / gear / hat ids, no photo is read, uploaded or
// stored. Nothing in the bucket can be read or written by a client.
service firebase.storage {
  match /b/{bucket}/o {
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
